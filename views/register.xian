<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Create Account · DJYum</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            charcoal: { DEFAULT: "#1F1B16", 800: "#2A241D" },
            cream: "#FAF6EF",
            ember: { DEFAULT: "#F97316", 600: "#EA580C", 50: "#FFF3E6" }
          },
          fontFamily: { sans: ["Inter", "ui-sans-serif", "system-ui", "sans-serif"] }
        }
      }
    };
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>body{font-family:Inter,ui-sans-serif,system-ui,sans-serif}</style>
</head>
<body class="min-h-screen bg-cream text-stone-800">
  <div class="mx-auto flex min-h-screen max-w-lg flex-col justify-center px-6 py-12">
    <div class="mb-8 flex items-center gap-3">
      <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-ember text-xl">🍽️</div>
      <div>
        <p class="text-lg font-extrabold text-charcoal">DJYum</p>
        <p class="text-[10px] uppercase tracking-[0.2em] text-stone-500">POS &amp; Inventory</p>
      </div>
    </div>

    <h1 class="text-2xl font-extrabold tracking-tight text-charcoal">Create your account</h1>
    <p class="mt-1 text-sm text-stone-500">Accounts you create here start with cashier access. An administrator can change roles in Settings.</p>

    {{#if isFirstUser}}
      <div class="mt-4 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
        <strong>First account:</strong> this user becomes the system Administrator / Owner.
      </div>
    {{/if}}

    {{> flash}}

    <form method="POST" action="/register" class="mt-6 space-y-4 rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
      <div>
        <label class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-stone-500" for="name">Full name</label>
        <input id="name" type="text" name="name" required autocomplete="name" placeholder="Juan Dela Cruz"
          class="w-full rounded-xl border border-stone-300 px-3.5 py-2.5 text-sm outline-none focus:border-ember focus:ring-4 focus:ring-ember/15" />
      </div>
      <div>
        <label class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-stone-500" for="email">Email address</label>
        <input id="email" type="email" name="email" required autocomplete="email" placeholder="you@djsrestaurant.com"
          class="w-full rounded-xl border border-stone-300 px-3.5 py-2.5 text-sm outline-none focus:border-ember focus:ring-4 focus:ring-ember/15" />
      </div>
      <div>
        <label class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-stone-500" for="password">Password</label>
        <input id="password" type="password" name="password" required minlength="6" autocomplete="new-password" placeholder="At least 6 characters"
          class="w-full rounded-xl border border-stone-300 px-3.5 py-2.5 text-sm outline-none focus:border-ember focus:ring-4 focus:ring-ember/15" />
      </div>
      <button type="submit" class="w-full rounded-xl bg-ember px-4 py-2.5 text-sm font-bold text-white transition hover:bg-ember-600">
        Create Account
      </button>
      <p class="text-center text-xs text-stone-500">
        Already registered? <a href="/login" class="font-semibold text-ember hover:underline">Sign in</a>
      </p>
    </form>
  </div>
</body>
</html>
