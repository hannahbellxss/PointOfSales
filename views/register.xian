<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Create Account · DJYum</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            charcoal: { DEFAULT: "#0A0A0B", 800: "#141417" },
            cream: "#0A0A0B",
            ember: { DEFAULT: "#FFC400", 600: "#E5AF00", 50: "#3A2F00" }
          },
          fontFamily: { sans: ["Inter", "ui-sans-serif", "system-ui", "sans-serif"] }
        }
      }
    };
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    body { font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
    .field { width: 100%; border: 1px solid #2a2a31; border-radius: .75rem; padding: .65rem .9rem; font-size: .875rem; background: #0f0f12; color: #f4f4f5; }
    .field::placeholder { color: #52525b; }
    .field:focus { outline: none; border-color: #FFC400; box-shadow: 0 0 0 4px rgba(255, 196, 0, .15); }
  </style>
</head>
<body class="min-h-screen bg-cream text-zinc-200">
  <div class="mx-auto flex min-h-screen max-w-lg flex-col justify-center px-6 py-12">
    <div class="mb-8 flex items-center gap-3">
      <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-ember text-xl text-black"></div>
      <div>
        <p class="text-lg font-extrabold text-white">DJYum</p>
        <p class="text-[10px] uppercase tracking-[0.2em] text-zinc-500">POS &amp; Inventory</p>
      </div>
    </div>

    <h1 class="text-2xl font-extrabold tracking-tight text-white">Create your account</h1>
    <p class="mt-1 text-sm text-zinc-400">Accounts you create here start with cashier access. An administrator can change roles in Settings.</p>

    {{#if isFirstUser}}
      <div class="mt-4 rounded-xl border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-sm text-amber-300">
        <strong>First account:</strong> this user becomes the system Administrator / Owner.
      </div>
    {{/if}}

    {{> flash}}

    <form method="POST" action="/register" class="mt-6 space-y-4 rounded-2xl border border-white/10 bg-[#141417] p-6 shadow-2xl shadow-black/50">
      <div>
        <label class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-zinc-400" for="name">Full name</label>
        <input id="name" type="text" name="name" required autocomplete="name" placeholder="Juan Dela Cruz"
          class="field" />
      </div>
      <div>
        <label class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-zinc-400" for="email">Email address</label>
        <input id="email" type="email" name="email" required autocomplete="email" placeholder="you@djsrestaurant.com"
          class="field" />
      </div>
      <div>
        <label class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-zinc-400" for="password">Password</label>
        <input id="password" type="password" name="password" required minlength="6" autocomplete="new-password" placeholder="At least 6 characters"
          class="field" />
      </div>
      <button type="submit" class="w-full rounded-xl bg-ember px-4 py-2.5 text-sm font-extrabold text-black transition hover:bg-ember-600">
        Create Account
      </button>
      <p class="text-center text-xs text-zinc-400">
        Already registered? <a href="/login" class="font-semibold text-ember hover:underline">Sign in</a>
      </p>
    </form>
  </div>
</body>
</html>
