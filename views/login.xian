<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign In · DJYum</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            charcoal: { DEFAULT: "#0A0A0B", 800: "#141417" },
            cream: "#0A0A0B",
            ember: { DEFAULT: "#FFC400", 600: "#E5AF00", 50: "#3A2F00" }
          },
          fontFamily: { sans: ["Inter", "ui-sans-serif", "system-ui", "sans-serif"] }
        }
      }
    };
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    body { font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
    .field { width: 100%; border: 1px solid #2a2a31; border-radius: .75rem; padding: .65rem .9rem; font-size: .875rem; background: #0f0f12; color: #f4f4f5; }
    .field::placeholder { color: #52525b; }
    .field:focus { outline: none; border-color: #FFC400; box-shadow: 0 0 0 4px rgba(255, 196, 0, .15); }
  </style>
</head>
<body class="min-h-screen bg-cream text-zinc-200">
  <div class="grid min-h-screen lg:grid-cols-2">
    <div class="relative hidden flex-col justify-between overflow-hidden bg-black p-12 text-white lg:flex">
      <div>
        <div class="flex items-center gap-3">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-ember text-2xl text-black"></div>
          <div>
            <p class="text-xl font-extrabold">DJYum</p>
            <p class="text-[11px] uppercase tracking-[0.2em] text-zinc-500">POS &amp; Inventory</p>
          </div>
        </div>
        <h2 class="mt-16 max-w-md text-4xl font-extrabold leading-tight">
          Every sale,<br />every plate,<br /><span class="text-ember">perfectly accounted.</span>
        </h2>
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-zinc-400">
          Fast point-of-sale for DJ's Restaurant with automatic inventory deduction, live stock alerts and sales reports.
        </p>
      </div>
      <div class="grid grid-cols-3 gap-4 text-xs text-zinc-400">
        <div class="rounded-xl border border-white/10 bg-white/5 p-3"><p class="text-lg font-bold text-ember">POS</p>Counter &amp; dine-in</div>
        <div class="rounded-xl border border-white/10 bg-white/5 p-3"><p class="text-lg font-bold text-ember">Stock</p>Auto deduction</div>
        <div class="rounded-xl border border-white/10 bg-white/5 p-3"><p class="text-lg font-bold text-ember">Reports</p>Sales &amp; inventory</div>
      </div>
      <div class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-ember/20 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-32 -left-10 h-72 w-72 rounded-full bg-ember/10 blur-3xl"></div>
    </div>

    <div class="flex items-center justify-center p-6 sm:p-12">
      <div class="w-full max-w-md">
        <div class="mb-8 flex items-center gap-3 lg:hidden">
          <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-ember text-xl text-black"></div>
          <div>
            <p class="text-lg font-extrabold text-white">DJYum</p>
            <p class="text-[10px] uppercase tracking-[0.2em] text-zinc-500">POS &amp; Inventory</p>
          </div>
        </div>

        <h1 class="text-2xl font-extrabold tracking-tight text-white">Welcome back</h1>
        <p class="mt-1 text-sm text-zinc-400">Sign in to open the POS terminal and manage DJ's Restaurant.</p>

        {{> flash}}

        <form method="POST" action="/login" class="mt-6 space-y-4 rounded-2xl border border-white/10 bg-[#141417] p-6 shadow-2xl shadow-black/50">
          <div>
            <label class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-zinc-400" for="email">Email address</label>
            <input id="email" type="email" name="email" required autocomplete="email" placeholder="you@djsrestaurant.com"
              class="field" />
          </div>
          <div>
            <label class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-zinc-400" for="password">Password</label>
            <input id="password" type="password" name="password" required autocomplete="current-password" placeholder="••••••••"
              class="field" />
          </div>
          <button type="submit" class="w-full rounded-xl bg-ember px-4 py-2.5 text-sm font-extrabold text-black transition hover:bg-ember-600">
            Sign In
          </button>
          <div class="flex items-center justify-between text-xs">
            <a href="/forgot-password" class="font-semibold text-zinc-400 hover:text-ember">Forgot password?</a>
            <a href="/register" class="font-semibold text-ember hover:underline">Create an account</a>
          </div>
        </form>

        <p class="mt-6 text-center text-[11px] text-zinc-600">DJYum · POS &amp; Inventory Management System</p>
      </div>
    </div>
  </div>
</body>
</html>
