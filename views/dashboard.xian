{{> app-head title="Dashboard" active="dashboard" subtitle="Live overview of sales, orders and inventory"}}

<section class="grid grid-cols-2 gap-4 xl:grid-cols-4">
  <div class="card p-5">
    <div class="flex items-start justify-between">
      <p class="text-[11px] font-bold uppercase tracking-wider text-zinc-500">Total Sales Today</p>
      <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-ember/10 text-ember">₱</span>
    </div>
    <p class="stat-value mt-3">{{money summary.salesToday}}</p>
    <p class="mt-1 text-xs text-zinc-400">{{summary.transactionsToday}} completed transaction(s)</p>
  </div>

  <div class="card p-5">
    <div class="flex items-start justify-between">
      <p class="text-[11px] font-bold uppercase tracking-wider text-zinc-500">Total Transactions</p>
      <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-white/[0.06]">🧾</span>
    </div>
    <p class="stat-value mt-3">{{int summary.transactionsToday}}</p>
    <p class="mt-1 text-xs text-zinc-400">{{summary.cancelledToday}} voided/cancelled today</p>
  </div>

  <div class="card p-5">
    <div class="flex items-start justify-between">
      <p class="text-[11px] font-bold uppercase tracking-wider text-zinc-500">Orders Today</p>
      <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-white/[0.06]">🛎️</span>
    </div>
    <p class="stat-value mt-3">{{int summary.ordersToday}}</p>
    <p class="mt-1 text-xs text-zinc-400">{{summary.totalOrders}} order(s) all time</p>
  </div>

  <div class="card p-5">
    <div class="flex items-start justify-between">
      <p class="text-[11px] font-bold uppercase tracking-wider text-zinc-500">Total Products</p>
      <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-white/[0.06]">🍔</span>
    </div>
    <p class="stat-value mt-3">{{int summary.totalProducts}}</p>
    <p class="mt-1 text-xs text-zinc-400">Active menu items</p>
  </div>

  <div class="card p-5">
    <div class="flex items-start justify-between">
      <p class="text-[11px] font-bold uppercase tracking-wider text-zinc-500">Available Stock</p>
      <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-500/10">📦</span>
    </div>
    <p class="stat-value mt-3">{{int summary.totalStock}}</p>
    <p class="mt-1 text-xs text-zinc-400">Units across all products</p>
  </div>

  <a href="/pos/inventory/low-stock" class="card p-5 transition hover:-translate-y-0.5 hover:shadow-md">
    <div class="flex items-start justify-between">
      <p class="text-[11px] font-bold uppercase tracking-wider text-zinc-500">Low Stock Products</p>
      <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-amber-500/10">⚠️</span>
    </div>
    <p class="stat-value mt-3 {{#if summary.lowStock}}text-amber-400{{/if}}">{{int summary.lowStock}}</p>
    <p class="mt-1 text-xs text-zinc-400">At or below minimum level</p>
  </a>

  <a href="/pos/inventory/out-of-stock" class="card p-5 transition hover:-translate-y-0.5 hover:shadow-md">
    <div class="flex items-start justify-between">
      <p class="text-[11px] font-bold uppercase tracking-wider text-zinc-500">Out of Stock</p>
      <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-red-500/10">⛔</span>
    </div>
    <p class="stat-value mt-3 {{#if summary.outOfStock}}text-red-400{{/if}}">{{int summary.outOfStock}}</p>
    <p class="mt-1 text-xs text-zinc-400">Cannot be sold until restocked</p>
  </a>

  <a href="/pos/tables" class="card p-5 transition hover:-translate-y-0.5 hover:shadow-md">
    <div class="flex items-start justify-between">
      <p class="text-[11px] font-bold uppercase tracking-wider text-zinc-500">Tables</p>
      <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-white/[0.06]">🪑</span>
    </div>
    <p class="stat-value mt-3">{{int summary.tablesAvailable}}<span class="text-base font-semibold text-zinc-500">/{{int summary.tablesTotal}}</span></p>
    <p class="mt-1 text-xs text-zinc-400">{{summary.tablesOccupied}} occupied</p>
  </a>
</section>

<section class="grid gap-6 xl:grid-cols-3">
  <div class="card p-5 xl:col-span-2">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 class="text-base font-bold text-white">Sales Trend</h2>
        <p class="text-xs text-zinc-400">Completed transactions only</p>
      </div>
      <div class="flex rounded-xl border border-white/10 bg-white/[0.04] p-1 text-xs font-semibold">
        <button type="button" data-range="daily" class="chart-tab rounded-lg px-3 py-1.5">Daily</button>
        <button type="button" data-range="weekly" class="chart-tab rounded-lg px-3 py-1.5">Weekly</button>
        <button type="button" data-range="monthly" class="chart-tab rounded-lg px-3 py-1.5">Monthly</button>
      </div>
    </div>
    <div class="mt-4 h-72"><canvas id="salesChart"></canvas></div>
  </div>

  <div class="card p-5">
    <div class="flex items-center justify-between">
      <h2 class="text-base font-bold text-white">Best Sellers</h2>
      <span class="text-[10px] font-bold uppercase tracking-wider text-zinc-500">30 days</span>
    </div>
    <div class="mt-4 space-y-3">
      {{#each bestSellers}}
        <div class="flex items-center gap-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-ember/10 text-xs font-bold text-ember">{{@index}}</span>
          <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-semibold text-zinc-100">{{this.name}}</p>
            <p class="text-xs text-zinc-400">{{int this.qty}} sold</p>
          </div>
          <span class="text-sm font-bold text-zinc-200">{{money this.revenue}}</span>
        </div>
      {{else}}
        <p class="rounded-xl bg-white/[0.04] px-4 py-8 text-center text-sm text-zinc-400">No completed sales yet.</p>
      {{/each}}
    </div>

    <div class="mt-5 grid grid-cols-2 gap-2">
      {{#can "pos"}}
        <a href="/pos/terminal" class="btn btn-primary w-full">Open POS</a>
      {{/can}}
      {{#can "menu"}}
        <a href="/pos/products/new" class="btn btn-light w-full">Add Product</a>
      {{/can}}
    </div>
  </div>
</section>

<section class="grid gap-6 xl:grid-cols-2">
  <div class="card overflow-hidden">
    <div class="flex items-center justify-between border-b border-white/10 px-5 py-4">
      <h2 class="text-base font-bold text-white">Recent Transactions</h2>
      {{#can "transactions"}}<a href="/pos/transactions" class="text-xs font-semibold text-ember hover:underline">View all</a>{{/can}}
    </div>
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr><th>Transaction</th><th>Type</th><th>Cashier</th><th>Total</th><th>Time</th></tr>
        </thead>
        <tbody>
          {{#each recentTransactions}}
            <tr>
              <td class="font-semibold text-zinc-100">{{this.transactionNumber}}</td>
              <td>{{this.order.orderType}}</td>
              <td class="text-zinc-400">{{this.cashierName}}</td>
              <td class="font-bold">{{money this.totalAmount}}</td>
              <td class="text-zinc-400">{{time this.createdAt}}</td>
            </tr>
          {{else}}
            <tr><td colspan="5" class="py-8 text-center text-zinc-400">No transactions recorded yet.</td></tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>

  <div class="card overflow-hidden">
    <div class="flex items-center justify-between border-b border-white/10 px-5 py-4">
      <h2 class="text-base font-bold text-white">Recent Inventory Movements</h2>
      {{#can "inventory"}}<a href="/pos/inventory/movements" class="text-xs font-semibold text-ember hover:underline">View all</a>{{/can}}
    </div>
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr><th>Product</th><th>Type</th><th>Qty</th><th>Stock</th><th>When</th></tr>
        </thead>
        <tbody>
          {{#each recentMovements}}
            <tr>
              <td class="font-semibold text-zinc-100">{{this.productName}}</td>
              <td><span class="badge bg-white/[0.06] text-zinc-300">{{this.type}}</span></td>
              <td class="font-semibold">{{int this.quantity}}</td>
              <td class="text-zinc-400">{{int this.previousStock}} → {{int this.newStock}}</td>
              <td class="text-zinc-400">{{datetime this.createdAt}}</td>
            </tr>
          {{else}}
            <tr><td colspan="5" class="py-8 text-center text-zinc-400">No stock movements yet.</td></tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
  const CHART_DATA = {{{json charts}}};
  let salesChart = null;

  function renderSalesChart(range) {
    const data = CHART_DATA[range] || [];
    const canvas = document.getElementById("salesChart");
    if (!canvas || typeof Chart === "undefined") return;

    if (salesChart) salesChart.destroy();
    salesChart = new Chart(canvas.getContext("2d"), {
      type: "bar",
      data: {
        labels: data.map((point) => point.label),
        datasets: [{
          label: "Sales",
          data: data.map((point) => point.total),
          backgroundColor: "#FFC400",
          hoverBackgroundColor: "#E5AF00",
          borderRadius: 8,
          maxBarThickness: 42
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: (context) => `Sales: ₱${Number(context.raw).toLocaleString(undefined, { minimumFractionDigits: 2 })}`
            }
          }
        },
        scales: {
          x: { grid: { display: false }, ticks: { color: "#71717a", font: { size: 11 } } },
          y: {
            beginAtZero: true,
            grid: { color: "rgba(255,255,255,.08)" },
            ticks: { color: "#71717a", font: { size: 11 }, callback: (value) => `₱${value}` }
          }
        }
      }
    });
  }

  function setActiveTab(active) {
    document.querySelectorAll(".chart-tab").forEach((tab) => {
      const isActive = tab.dataset.range === active;
      tab.className = `chart-tab rounded-lg px-3 py-1.5 ${isActive ? "bg-ember text-black shadow-sm" : "text-zinc-400"}`;
    });
  }

  document.querySelectorAll(".chart-tab").forEach((tab) => {
    tab.addEventListener("click", () => {
      setActiveTab(tab.dataset.range);
      renderSalesChart(tab.dataset.range);
    });
  });

  setActiveTab("daily");
  renderSalesChart("daily");
</script>

{{> app-foot}}
