<header class="sticky top-0 z-20 border-b border-stone-200/70 bg-cream/90 px-4 py-4 backdrop-blur sm:px-6 lg:px-8">
  <div class="flex items-center gap-3">
    <button type="button" class="rounded-lg border border-stone-300 bg-white px-2.5 py-1.5 text-stone-600 lg:hidden" onclick="toggleSidebar()" aria-label="Open menu">☰</button>
    <div class="min-w-0">
      <h1 class="truncate text-xl font-extrabold tracking-tight text-charcoal sm:text-2xl">{{title}}</h1>
      <p class="mt-0.5 truncate text-xs text-stone-500">{{#if subtitle}}{{subtitle}}{{else}}DJYum · DJ's Restaurant{{/if}}</p>
    </div>
    <div class="ml-auto flex items-center gap-2">
      {{#can "pos"}}
        <a href="/pos/terminal" class="btn btn-primary hidden sm:inline-flex">+ New Sale</a>
      {{/can}}
      <span class="hidden rounded-xl border border-stone-200 bg-white px-3 py-2 text-xs font-semibold text-stone-600 md:inline-flex">
        {{initials currentUser.name}} · {{currentUser.role}}
      </span>
    </div>
  </div>
</header>
