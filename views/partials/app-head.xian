<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{title}} · DJYum</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            ink: "#0A0A0B",
            charcoal: { DEFAULT: "#0A0A0B", 800: "#141417", 700: "#1C1C21" },
            panel: "#141417",
            cream: "#0A0A0B",
            ember: { DEFAULT: "#FFC400", 600: "#E5AF00", 50: "#3A2F00" }
          },
          fontFamily: { sans: ["Inter", "ui-sans-serif", "system-ui", "sans-serif"] }
        }
      }
    };
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    body { font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
    .card { background: #141417; border: 1px solid rgba(255, 255, 255, .08); border-radius: 1rem; box-shadow: 0 1px 2px rgba(0, 0, 0, .5); }
    .nav-link { display: flex; align-items: center; gap: .7rem; padding: .58rem .75rem; border-radius: .7rem; color: #a1a1aa; font-weight: 500; transition: background .15s, color .15s; }
    .nav-link:hover { background: rgba(255, 255, 255, .07); color: #fff; }
    .nav-link.active { background: #FFC400; color: #0A0A0B; font-weight: 700; box-shadow: 0 10px 24px -12px rgba(255, 196, 0, .9); }
    .nav-section { margin: 1.1rem .75rem .35rem; font-size: .64rem; letter-spacing: .16em; text-transform: uppercase; color: #71717a; font-weight: 700; }
    .nav-icon { width: 1.15rem; text-align: center; font-size: 1rem; flex-shrink: 0; }
    .stat-value { font-size: 1.6rem; line-height: 1.9rem; font-weight: 800; color: #fafafa; letter-spacing: -.02em; }
    .input, .select, .textarea { width: 100%; border: 1px solid #2a2a31; border-radius: .65rem; padding: .55rem .75rem; font-size: .875rem; background: #0f0f12; color: #f4f4f5; }
    .input::placeholder, .textarea::placeholder { color: #52525b; }
    .input:focus, .select:focus, .textarea:focus { outline: none; border-color: #FFC400; box-shadow: 0 0 0 3px rgba(255, 196, 0, .16); }
    .select option { background: #141417; color: #f4f4f5; }
    .label { display: block; font-size: .72rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: #a1a1aa; margin-bottom: .35rem; }
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: .45rem; border-radius: .7rem; padding: .55rem .95rem; font-size: .82rem; font-weight: 700; transition: all .15s; white-space: nowrap; }
    .btn-primary { background: #FFC400; color: #0A0A0B; }
    .btn-primary:hover { background: #FFD54A; }
    .btn-dark { background: #27272a; color: #fafafa; border: 1px solid rgba(255, 255, 255, .1); }
    .btn-dark:hover { background: #3f3f46; }
    .btn-light { background: #1b1b20; color: #e4e4e7; border: 1px solid rgba(255, 255, 255, .12); }
    .btn-light:hover { background: #26262c; color: #fff; }
    .btn-danger { background: #dc2626; color: #fff; }
    .btn-danger:hover { background: #b91c1c; }
    .badge { display: inline-flex; align-items: center; gap: .25rem; border-radius: 999px; padding: .18rem .6rem; font-size: .7rem; font-weight: 700; --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 0 1px var(--ring, transparent); box-shadow: var(--tw-ring-offset-shadow), var(--tw-ring-shadow); }
    .table-wrap { overflow-x: auto; }
    .data-table { width: 100%; border-collapse: separate; border-spacing: 0; font-size: .83rem; }
    .data-table thead th { text-align: left; font-size: .66rem; letter-spacing: .1em; text-transform: uppercase; color: #71717a; font-weight: 700; padding: .7rem 1rem; background: #17171b; border-bottom: 1px solid rgba(255, 255, 255, .08); white-space: nowrap; }
    .data-table tbody td { padding: .75rem 1rem; border-bottom: 1px solid rgba(255, 255, 255, .06); vertical-align: middle; }
    .data-table tbody tr:hover { background: rgba(255, 255, 255, .03); }
    .data-table tbody tr:last-child td { border-bottom: 0; }
    ::-webkit-scrollbar { width: 10px; height: 10px; }
    ::-webkit-scrollbar-thumb { background: #2a2a31; border-radius: 999px; }
    @media print { .no-print { display: none !important; } body { background: #fff; } }
  </style>
</head>
<body class="bg-cream text-zinc-200 antialiased">
<div class="min-h-screen lg:flex">
  {{> sidebar active=active}}
  <div id="sidebar-overlay" class="fixed inset-0 z-30 hidden bg-black/60 lg:hidden" onclick="toggleSidebar()"></div>

  <div class="flex min-w-0 flex-1 flex-col">
    {{> topbar title=title subtitle=subtitle}}
    <main class="flex-1 space-y-6 p-4 sm:p-6 lg:p-8">
      {{> flash}}
