<aside id="sidebar" class="fixed inset-y-0 left-0 z-40 flex w-72 -translate-x-full flex-col bg-black text-zinc-400 transition-transform duration-200 lg:static lg:translate-x-0 lg:border-r lg:border-white/5">
  <div class="flex items-center gap-3 border-b border-white/10 px-5 py-5">
    <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-ember text-xl text-black shadow-lg shadow-ember/30">🍽️</div>
    <div class="min-w-0">
      <p class="text-lg font-extrabold leading-tight text-white">DJYum</p>
      <p class="truncate text-[10px] font-semibold uppercase tracking-[0.18em] text-zinc-500">POS &amp; Inventory</p>
    </div>
    <button type="button" class="ml-auto text-zinc-500 hover:text-ember lg:hidden" onclick="toggleSidebar()" aria-label="Close menu">✕</button>
  </div>

  <nav class="flex-1 space-y-1 overflow-y-auto px-3 py-3 text-[13px]">
    <a href="/dashboard" class="nav-link {{#if (eq active 'dashboard')}}active{{/if}}">
      <span class="nav-icon">▦</span> Dashboard
    </a>

    {{#can "pos"}}
      <a href="/pos/terminal" class="nav-link {{#if (eq active 'terminal')}}active{{/if}}">
        <span class="nav-icon">🛒</span> POS Terminal
      </a>
    {{/can}}

    {{#can "menu"}}
      <p class="nav-section">Menu Management</p>
      <a href="/pos/products" class="nav-link {{#if (eq active 'products')}}active{{/if}}">
        <span class="nav-icon">🍔</span> Products
      </a>
      <a href="/pos/categories" class="nav-link {{#if (eq active 'categories')}}active{{/if}}">
        <span class="nav-icon">🏷️</span> Categories
      </a>
    {{/can}}

    {{#can "inventory"}}
      <p class="nav-section">Inventory</p>
      <a href="/pos/inventory" class="nav-link {{#if (eq active 'inventory')}}active{{/if}}">
        <span class="nav-icon">📦</span> Inventory Overview
      </a>
      <a href="/pos/inventory/low-stock" class="nav-link">
        <span class="nav-icon">⚠️</span> Low Stock
      </a>
      <a href="/pos/inventory/out-of-stock" class="nav-link">
        <span class="nav-icon">⛔</span> Out of Stock
      </a>
      <a href="/pos/inventory/movements" class="nav-link">
        <span class="nav-icon">🔁</span> Stock Movements
      </a>
      {{#can "inventory.manage"}}
        <a href="/pos/inventory/stock-in" class="nav-link">
          <span class="nav-icon">⬆️</span> Stock In
        </a>
        <a href="/pos/inventory/stock-out" class="nav-link">
          <span class="nav-icon">⬇️</span> Stock Out
        </a>
        <a href="/pos/inventory/adjustment" class="nav-link">
          <span class="nav-icon">⚖️</span> Stock Adjustment
        </a>
      {{/can}}
    {{/can}}

    {{#can "orders"}}
      <p class="nav-section">Operations</p>
      <a href="/pos/orders" class="nav-link {{#if (eq active 'orders')}}active{{/if}}">
        <span class="nav-icon">🧾</span> Orders
      </a>
    {{/can}}
    {{#can "tables"}}
      <a href="/pos/tables" class="nav-link {{#if (eq active 'tables')}}active{{/if}}">
        <span class="nav-icon">🪑</span> Table Management
      </a>
    {{/can}}

    {{#can "transactions"}}
      <p class="nav-section">Finance</p>
      <a href="/pos/transactions" class="nav-link {{#if (eq active 'transactions')}}active{{/if}}">
        <span class="nav-icon">💳</span> Transactions
      </a>
    {{/can}}
    {{#can "reports.sales"}}
      <a href="/pos/reports/sales" class="nav-link {{#if (eq active 'reports-sales')}}active{{/if}}">
        <span class="nav-icon">📈</span> Sales Reports
      </a>
    {{/can}}
    {{#can "reports.inventory"}}
      <a href="/pos/reports/inventory" class="nav-link {{#if (eq active 'reports-inventory')}}active{{/if}}">
        <span class="nav-icon">📊</span> Inventory Reports
      </a>
    {{/can}}
    {{#can "settings"}}
      <p class="nav-section">System</p>
      <a href="/pos/settings" class="nav-link {{#if (eq active 'settings')}}active{{/if}}">
        <span class="nav-icon">⚙️</span> Settings
      </a>
    {{/can}}
  </nav>

  <div class="border-t border-white/10 p-4">
    <div class="flex items-center gap-3">
      <div class="flex h-9 w-9 items-center justify-center rounded-full bg-ember/20 text-xs font-bold text-ember">
        {{initials currentUser.name}}
      </div>
      <div class="min-w-0">
        <p class="truncate text-sm font-semibold text-white">{{currentUser.name}}</p>
        <p class="truncate text-[11px] capitalize text-zinc-500">{{currentUser.role}}</p>
      </div>
      <a href="/logout" class="ml-auto rounded-lg px-2 py-1 text-xs font-semibold text-zinc-500 hover:bg-white/10 hover:text-ember" title="Sign out">⎋</a>
    </div>
  </div>
</aside>
