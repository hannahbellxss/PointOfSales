{{> app-head title="POS Settings" active="settings" subtitle="Restaurant profile, discounts and user access"}}

<section class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_minmax(340px,1fr)]">
  <div class="space-y-6">
    <form method="POST" action="/pos/settings" class="card p-5">
      <h2 class="text-sm font-bold uppercase tracking-wider text-stone-500">Restaurant Profile</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <div>
          <label class="label" for="restaurantName">Restaurant name *</label>
          <input id="restaurantName" name="restaurantName" required maxlength="80" class="input" value="{{posSettings.restaurantName}}" />
        </div>
        <div>
          <label class="label" for="contact">Contact number</label>
          <input id="contact" name="contact" maxlength="80" class="input" value="{{posSettings.contact}}" />
        </div>
        <div class="sm:col-span-2">
          <label class="label" for="address">Address</label>
          <input id="address" name="address" maxlength="255" class="input" value="{{posSettings.address}}" />
        </div>
        <div>
          <label class="label" for="currency">Currency symbol *</label>
          <input id="currency" name="currency" required maxlength="8" class="input" value="{{posSettings.currency}}" />
        </div>
        <div>
          <label class="label" for="receiptPrefix">Receipt prefix</label>
          <input id="receiptPrefix" name="receiptPrefix" maxlength="24" class="input" value="{{posSettings.receiptPrefix}}" />
        </div>
        <div>
          <label class="label" for="taxRate">Tax rate (%)</label>
          <input id="taxRate" name="taxRate" type="number" step="0.01" min="0" max="100" class="input" value="{{posSettings.taxRate}}" />
          <p class="mt-1 text-[11px] text-stone-400">Applied to the discounted subtotal plus service charge.</p>
        </div>
        <div>
          <label class="label" for="serviceChargeRate">Service charge (%)</label>
          <input id="serviceChargeRate" name="serviceChargeRate" type="number" step="0.01" min="0" max="100" class="input" value="{{posSettings.serviceChargeRate}}" />
        </div>
        <div class="sm:col-span-2">
          <label class="label" for="receiptFooter">Receipt footer message</label>
          <input id="receiptFooter" name="receiptFooter" maxlength="255" class="input" value="{{posSettings.receiptFooter}}" />
        </div>
      </div>
      <button type="submit" class="btn btn-primary mt-4">Save Settings</button>
    </form>

    <div class="card overflow-hidden">
      <div class="border-b border-stone-200/80 px-5 py-4">
        <h2 class="text-base font-bold text-charcoal">Authorized Discounts</h2>
        <p class="text-xs text-stone-500">Only active discounts can be applied at checkout</p>
      </div>
      <div class="table-wrap">
        <table class="data-table">
          <thead><tr><th>Name</th><th>Type</th><th>Value</th><th>Status</th><th class="text-right">Actions</th></tr></thead>
          <tbody>
            {{#each discounts}}
              <tr>
                <td>
                  <details>
                    <summary class="cursor-pointer font-semibold text-stone-800">{{this.name}}</summary>
                    <form method="POST" action="/pos/settings/discounts/{{this.id}}" class="mt-2 flex flex-wrap items-end gap-2">
                      <input name="name" value="{{this.name}}" required maxlength="120" class="input w-44" />
                      <select name="type" class="select w-28">
                        <option value="percent" {{selected "percent" this.type}}>Percent</option>
                        <option value="fixed" {{selected "fixed" this.type}}>Fixed</option>
                      </select>
                      <input name="value" type="number" step="0.01" min="0.01" value="{{this.value}}" required class="input w-24" />
                      <button type="submit" class="btn btn-dark px-2.5 py-1 text-[11px]">Save</button>
                    </form>
                  </details>
                </td>
                <td class="capitalize text-stone-500">{{this.type}}</td>
                <td class="font-semibold">{{#if (eq this.type "percent")}}{{this.value}}%{{else}}{{money this.value}}{{/if}}</td>
                <td><span class="badge {{statusBadge this.status}}">{{this.status}}</span></td>
                <td class="text-right">
                  <form method="POST" action="/pos/settings/discounts/{{this.id}}">
                    <input type="hidden" name="action" value="toggle" />
                    <button type="submit" class="btn btn-light px-2.5 py-1 text-[11px]">
                      {{#if (eq this.status "active")}}Deactivate{{else}}Activate{{/if}}
                    </button>
                  </form>
                </td>
              </tr>
            {{else}}
              <tr><td colspan="5" class="py-8 text-center text-sm text-stone-500">No discounts configured.</td></tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      <div class="border-t border-stone-200/80 bg-stone-50 px-5 py-4">
        <form method="POST" action="/pos/settings/discounts" class="flex flex-wrap items-end gap-2">
          <div class="min-w-[160px] flex-1">
            <label class="label" for="discount-name">New discount</label>
            <input id="discount-name" name="name" required maxlength="120" class="input" placeholder="e.g. Student Discount" />
          </div>
          <div>
            <label class="label" for="discount-type">Type</label>
            <select id="discount-type" name="type" class="select w-28">
              <option value="percent">Percent</option>
              <option value="fixed">Fixed</option>
            </select>
          </div>
          <div>
            <label class="label" for="discount-value">Value</label>
            <input id="discount-value" name="value" type="number" step="0.01" min="0.01" required class="input w-24" />
          </div>
          <button type="submit" class="btn btn-primary">Add</button>
        </form>
      </div>
    </div>
  </div>

  <div class="space-y-6">
    <div class="card overflow-hidden">
      <div class="border-b border-stone-200/80 px-5 py-4">
        <h2 class="text-base font-bold text-charcoal">Users &amp; Roles</h2>
        <p class="text-xs text-stone-500">Role-based access control</p>
      </div>
      <div class="divide-y divide-stone-100">
        {{#each users}}
          <div class="px-5 py-4">
            <div class="flex items-center gap-3">
              <div class="flex h-9 w-9 items-center justify-center rounded-full bg-stone-100 text-xs font-bold text-stone-600">{{initials this.name}}</div>
              <div class="min-w-0 flex-1">
                <p class="truncate text-sm font-bold text-stone-800">{{this.name}}</p>
                <p class="truncate text-[11px] text-stone-500">{{this.email}}</p>
              </div>
              <span class="badge bg-stone-100 text-stone-600">{{lookup ../roleLabels this.role}}</span>
            </div>
            <form method="POST" action="/pos/settings/users/{{this.id}}/role" class="mt-2 flex items-center gap-2">
              <select name="role" class="select flex-1 py-1.5 text-xs">
                {{#each ../assignableRoles}}
                  <option value="{{this}}" {{selected this ../role}}>{{lookup ../../roleLabels this}}</option>
                {{/each}}
              </select>
              <button type="submit" class="btn btn-light px-2.5 py-1.5 text-[11px]">Update</button>
            </form>
          </div>
        {{/each}}
      </div>
    </div>

    <div class="card p-5">
      <h2 class="text-sm font-bold uppercase tracking-wider text-stone-500">Role Permissions</h2>
      <div class="mt-3 space-y-3 text-xs leading-relaxed text-stone-600">
        <p><span class="font-bold text-stone-800">Administrator</span> — full access, menu, inventory, reports, voids, posSettings.</p>
        <p><span class="font-bold text-stone-800">Cashier</span> — POS terminal, orders, tables, transactions and receipts.</p>
        <p><span class="font-bold text-stone-800">Inventory Staff</span> — stock levels, movements and inventory reports.</p>
        <p><span class="font-bold text-stone-800">Restaurant Staff</span> — order queue and preparation status.</p>
      </div>
    </div>

    <div class="card p-5 text-xs leading-relaxed text-stone-500">
      <h2 class="text-sm font-bold uppercase tracking-wider text-stone-500">Security Notes</h2>
      <ul class="mt-2 space-y-1.5">
        <li>• All totals and stock checks are recalculated on the server.</li>
        <li>• Duplicate payments are blocked at the database level.</li>
        <li>• Only administrators can void transactions and restore stock.</li>
        <li>• Every stock change is recorded with the user and timestamp.</li>
      </ul>
    </div>
  </div>
</section>

{{> app-foot}}
