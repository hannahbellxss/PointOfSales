<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Receipt {{transaction.transactionNumber}}</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    body { font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
    @media print {
      .no-print { display: none !important; }
      body { background: #fff; }
      .receipt { box-shadow: none !important; border: 0 !important; margin: 0 auto; width: 100%; max-width: 380px; }
      @page { margin: 8mm; }
    }
  </style>
</head>
<body class="min-h-screen bg-stone-100 py-8 text-stone-800">
  <div class="no-print mx-auto mb-4 flex max-w-md items-center justify-between px-4">
    <a href="/pos/transactions/{{transaction.id}}" class="rounded-lg border border-stone-300 bg-white px-3 py-2 text-xs font-semibold text-stone-700 hover:bg-stone-50">← Transactions</a>
    <div class="flex gap-2">
      <button type="button" onclick="window.print()" class="rounded-lg bg-orange-500 px-4 py-2 text-xs font-bold text-white hover:bg-orange-600">Print Receipt</button>
      <a href="/pos/terminal" class="rounded-lg border border-stone-300 bg-white px-3 py-2 text-xs font-semibold text-stone-700 hover:bg-stone-50">New Sale</a>
    </div>
  </div>

  <div class="receipt mx-auto max-w-md border border-stone-200 bg-white px-6 py-6 shadow-sm">
    <div class="text-center">
      <p class="text-lg font-extrabold uppercase tracking-wide text-stone-900">{{posSettings.restaurantName}}</p>
      <p class="mt-0.5 text-[11px] text-stone-500">{{posSettings.address}}</p>
      <p class="text-[11px] text-stone-500">{{posSettings.contact}}</p>
    </div>

    <div class="mt-4 border-y border-dashed border-stone-300 py-3 text-[11px]">
      <div class="flex justify-between"><span class="text-stone-500">Transaction</span><span class="font-bold">{{transaction.transactionNumber}}</span></div>
      <div class="flex justify-between"><span class="text-stone-500">Order</span><span class="font-semibold">{{transaction.orderNumber}}</span></div>
      <div class="flex justify-between"><span class="text-stone-500">Date</span><span class="font-semibold">{{datetime transaction.createdAt}}</span></div>
      <div class="flex justify-between"><span class="text-stone-500">Cashier</span><span class="font-semibold">{{transaction.cashierName}}</span></div>
      <div class="flex justify-between"><span class="text-stone-500">Type</span><span class="font-semibold">{{transaction.order.orderType}}</span></div>
      {{#if transaction.order.table}}
        <div class="flex justify-between"><span class="text-stone-500">Table</span><span class="font-semibold">{{transaction.order.table.name}}</span></div>
      {{/if}}
    </div>

    <table class="mt-3 w-full text-[11px]">
      <thead>
        <tr class="border-b border-stone-300 text-left text-[9px] uppercase tracking-wider text-stone-400">
          <th class="pb-1">Item</th><th class="pb-1 text-center">Qty</th><th class="pb-1 text-right">Unit</th><th class="pb-1 text-right">Amount</th>
        </tr>
      </thead>
      <tbody>
        {{#each transaction.order.items}}
          <tr class="border-b border-stone-100">
            <td class="py-1.5 pr-1 font-medium text-stone-800">{{this.productName}}</td>
            <td class="py-1.5 text-center">{{int this.quantity}}</td>
            <td class="py-1.5 text-right">{{money this.unitPrice}}</td>
            <td class="py-1.5 text-right font-semibold">{{money this.subtotal}}</td>
          </tr>
        {{/each}}
      </tbody>
    </table>

    <div class="mt-3 space-y-1 border-t border-dashed border-stone-300 pt-3 text-[11px]">
      <div class="flex justify-between"><span class="text-stone-500">Subtotal</span><span class="font-semibold">{{money transaction.subtotal}}</span></div>
      <div class="flex justify-between"><span class="text-stone-500">Discount</span><span class="font-semibold">−{{money transaction.discountAmount}}</span></div>
      {{#if (gt transaction.serviceCharge 0)}}
        <div class="flex justify-between"><span class="text-stone-500">Service charge</span><span class="font-semibold">{{money transaction.serviceCharge}}</span></div>
      {{/if}}
      {{#if (gt transaction.taxAmount 0)}}
        <div class="flex justify-between"><span class="text-stone-500">Tax</span><span class="font-semibold">{{money transaction.taxAmount}}</span></div>
      {{/if}}
      <div class="mt-1 flex justify-between border-t border-stone-300 pt-2 text-sm">
        <span class="font-extrabold">TOTAL</span><span class="font-extrabold">{{money transaction.totalAmount}}</span>
      </div>
    </div>

    <div class="mt-3 space-y-1 border-t border-dashed border-stone-300 pt-3 text-[11px]">
      {{#each transaction.payments}}
        <div class="flex justify-between"><span class="text-stone-500">Payment method</span><span class="font-semibold">{{this.method}}</span></div>
        <div class="flex justify-between"><span class="text-stone-500">Amount received</span><span class="font-semibold">{{money this.amountReceived}}</span></div>
        <div class="flex justify-between"><span class="text-stone-500">Change</span><span class="font-semibold">{{money this.changeDue}}</span></div>
        {{#if this.referenceNumber}}
          <div class="flex justify-between"><span class="text-stone-500">Reference</span><span class="font-semibold">{{this.referenceNumber}}</span></div>
        {{/if}}
      {{/each}}
    </div>

    <div class="mt-4 border-t border-dashed border-stone-300 pt-3 text-center">
      <p class="text-[11px] font-semibold text-stone-600">{{posSettings.receiptFooter}}</p>
      <p class="mt-2 text-[9px] uppercase tracking-[0.2em] text-stone-400">Reprint · No stock or sales changes</p>
      <p class="mt-1 text-[9px] text-stone-400">Powered by DJYum POS</p>
    </div>
  </div>

  {{#if transaction.status}}
    {{#if (ne transaction.status "Completed")}}
      <p class="mx-auto mt-4 max-w-md rounded-lg bg-red-50 px-4 py-2 text-center text-xs font-bold text-red-700">
        {{transaction.status}} transaction — not a valid sales receipt
      </p>
    {{/if}}
  {{/if}}
</body>
</html>
