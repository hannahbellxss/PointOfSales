{{> app-head title="Table Management" active="tables" subtitle="Dining floor availability for dine-in orders"}}

<section class="grid grid-cols-2 gap-3 lg:grid-cols-4">
  <div class="card p-4"><p class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Total tables</p><p class="stat-value mt-1 text-xl">{{int totals.total}}</p></div>
  <div class="card p-4"><p class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Available</p><p class="stat-value mt-1 text-xl text-emerald-600">{{int totals.available}}</p></div>
  <div class="card p-4"><p class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Occupied</p><p class="stat-value mt-1 text-xl text-orange-600">{{int totals.occupied}}</p></div>
  <div class="card p-4"><p class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Reserved</p><p class="stat-value mt-1 text-xl text-sky-600">{{int totals.reserved}}</p></div>
</section>

<section class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_340px]">
  <div class="grid gap-4 sm:grid-cols-2 2xl:grid-cols-3">
    {{#each tables}}
      <article class="card overflow-hidden">
        <div class="flex items-start justify-between gap-3 p-4">
          <div>
            <h2 class="text-base font-bold text-charcoal">{{this.name}}</h2>
            <p class="text-[11px] text-stone-500">{{this.capacity}} seats · {{#if this.location}}{{this.location}}{{else}}No section{{/if}}</p>
          </div>
          <span class="badge {{badge this.status}}">{{this.status}}</span>
        </div>

        {{#if this.activeOrder}}
          <div class="mx-4 rounded-xl bg-ember-50 px-3 py-2 text-[11px]">
            <p class="font-bold text-ember">{{this.activeOrder.orderNumber}}</p>
            <p class="text-stone-600">{{this.activeOrder.status}} · {{money this.activeOrder.totalAmount}}</p>
            <a href="/pos/orders/{{this.activeOrder.id}}" class="mt-1 inline-block font-semibold text-ember hover:underline">View order →</a>
          </div>
        {{else}}
          <div class="mx-4 rounded-xl bg-stone-50 px-3 py-2 text-[11px] text-stone-500">No active order</div>
        {{/if}}

        <div class="flex flex-wrap items-center gap-1.5 p-4">
          {{#if (ne this.status "Available")}}
            <form method="POST" action="/pos/tables/{{this.id}}/status">
              <input type="hidden" name="status" value="Available" />
              <button type="submit" class="btn btn-light px-2.5 py-1 text-[11px]">Set Available</button>
            </form>
          {{/if}}
          {{#if (ne this.status "Reserved")}}
            <form method="POST" action="/pos/tables/{{this.id}}/status">
              <input type="hidden" name="status" value="Reserved" />
              <button type="submit" class="btn btn-light px-2.5 py-1 text-[11px]">Reserve</button>
            </form>
          {{/if}}
          {{#if (ne this.status "Occupied")}}
            <form method="POST" action="/pos/tables/{{this.id}}/status">
              <input type="hidden" name="status" value="Occupied" />
              <button type="submit" class="btn btn-light px-2.5 py-1 text-[11px]">Occupy</button>
            </form>
          {{/if}}
          {{#can "pos"}}
            <a href="/pos/terminal" class="btn btn-primary ml-auto px-2.5 py-1 text-[11px]">New order</a>
          {{/can}}
        </div>

        <details class="border-t border-stone-100 px-4 py-3">
          <summary class="cursor-pointer text-[11px] font-semibold text-stone-500 hover:text-ember">Edit table</summary>
          <form method="POST" action="/pos/tables/{{this.id}}" class="mt-3 space-y-2">
            <input name="name" value="{{this.name}}" required maxlength="60" class="input" />
            <div class="grid grid-cols-2 gap-2">
              <input name="capacity" type="number" min="1" max="40" value="{{this.capacity}}" required class="input" />
              <input name="location" value="{{this.location}}" maxlength="80" class="input" placeholder="Section" />
            </div>
            <button type="submit" class="btn btn-dark w-full text-[11px]">Save table</button>
          </form>
        </details>
      </article>
    {{else}}
      <div class="card p-10 text-center sm:col-span-2">
        <p class="text-3xl">🪑</p>
        <p class="mt-2 text-sm font-semibold text-stone-700">No tables configured</p>
        <p class="text-xs text-stone-500">Add your first table using the form on the right.</p>
      </div>
    {{/each}}
  </div>

  {{#can "pos"}}
    <aside class="card h-fit p-5">
      <h2 class="text-sm font-bold uppercase tracking-wider text-stone-500">Add Table</h2>
      <form method="POST" action="/pos/tables" class="mt-4 space-y-3">
        <div>
          <label class="label" for="name">Table name *</label>
          <input id="name" name="name" required maxlength="60" class="input" placeholder="e.g. Table 9" />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="label" for="capacity">Seats *</label>
            <input id="capacity" name="capacity" type="number" min="1" max="40" value="4" required class="input" />
          </div>
          <div>
            <label class="label" for="location">Section</label>
            <input id="location" name="location" maxlength="80" class="input" placeholder="Main Hall" />
          </div>
        </div>
        <button type="submit" class="btn btn-primary w-full">Add Table</button>
      </form>
      <p class="mt-4 text-[11px] leading-relaxed text-stone-500">
        A table cannot be marked Available while it still has an active dine-in order.
      </p>
    </aside>
  {{/can}}
</section>

{{> app-foot}}
