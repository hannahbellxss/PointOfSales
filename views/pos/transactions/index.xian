{{> app-head title="Transaction History" active="transactions" subtitle="Every recorded sale, payment and void"}}

<section class="grid grid-cols-3 gap-3">
  <div class="card p-4"><p class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Transactions</p><p class="stat-value mt-1 text-xl">{{int summary.count}}</p></div>
  <div class="card p-4"><p class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Completed sales</p><p class="stat-value mt-1 text-xl text-emerald-700">{{money summary.completedSales}}</p></div>
  <div class="card p-4"><p class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Voided / refunded</p><p class="stat-value mt-1 text-xl text-red-600">{{money summary.voidedSales}}</p></div>
</section>

<section class="card p-4">
  <form method="GET" action="/pos/transactions" class="grid gap-3 lg:grid-cols-[minmax(0,1fr)_150px_150px_150px_160px_150px_auto]">
    <input type="search" name="q" value="{{filters.q}}" class="input" placeholder="Transaction or order number…" />
    <input type="date" name="from" value="{{filters.from}}" class="input" />
    <input type="date" name="to" value="{{filters.to}}" class="input" />
    <select name="method" class="select">
      <option value="">All methods</option>
      {{#each methods}}
        <option value="{{this}}" {{selected this ../filters.method}}>{{this}}</option>
      {{/each}}
    </select>
    <select name="cashier" class="select">
      <option value="">All cashiers</option>
      {{#each cashiers}}
        <option value="{{this.cashierId}}" {{selected this.cashierId ../filters.cashier}}>{{this.cashierName}}</option>
      {{/each}}
    </select>
    <select name="status" class="select">
      <option value="">All payment status</option>
      <option value="Paid" {{selected "Paid" filters.status}}>Paid</option>
      <option value="Refunded" {{selected "Refunded" filters.status}}>Refunded</option>
      <option value="Failed" {{selected "Failed" filters.status}}>Failed</option>
      <option value="Pending" {{selected "Pending" filters.status}}>Pending</option>
    </select>
    <div class="flex gap-2">
      <button type="submit" class="btn btn-dark">Filter</button>
      <a href="/pos/transactions" class="btn btn-light">Reset</a>
    </div>
  </form>
</section>

<section class="card overflow-hidden">
  <div class="table-wrap">
    <table class="data-table">
      <thead><tr><th>Transaction</th><th>Order</th><th>Cashier</th><th>Method</th><th>Subtotal</th><th>Discount</th><th>Total</th><th>Payment</th><th>Status</th><th>Date</th><th class="text-right">Actions</th></tr></thead>
      <tbody>
        {{#each transactions}}
          <tr>
            <td class="font-mono text-[11px] font-bold text-charcoal">{{this.transactionNumber}}</td>
            <td class="text-stone-500">{{this.orderNumber}}</td>
            <td class="text-stone-600">{{this.cashierName}}</td>
            <td>
              {{#each this.payments}}
                <span class="badge bg-stone-100 text-stone-600">{{this.method}}</span>
              {{/each}}
            </td>
            <td class="text-stone-600">{{money this.subtotal}}</td>
            <td class="text-stone-600">−{{money this.discountAmount}}</td>
            <td class="font-bold">{{money this.totalAmount}}</td>
            <td><span class="badge {{statusBadge this.paymentStatus}}">{{this.paymentStatus}}</span></td>
            <td><span class="badge {{statusBadge this.status}}">{{this.status}}</span></td>
            <td class="whitespace-nowrap text-stone-500">{{datetime this.createdAt}}</td>
            <td class="text-right">
              <div class="flex justify-end gap-1.5">
                <a href="/pos/transactions/{{this.id}}" class="btn btn-light px-2.5 py-1 text-[11px]">View</a>
                <a href="/pos/receipts/{{this.id}}" target="_blank" class="btn btn-light px-2.5 py-1 text-[11px]">Receipt</a>
              </div>
            </td>
          </tr>
        {{else}}
          <tr><td colspan="11" class="py-12 text-center">
            <p class="text-3xl">💳</p>
            <p class="mt-2 text-sm font-semibold text-stone-700">No transactions match this filter</p>
          </td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>

{{> app-foot}}
