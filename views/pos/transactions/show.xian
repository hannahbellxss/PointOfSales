{{> app-head title="Transaction Details" active="transactions" subtitle=transaction.transactionNumber}}

<div class="flex flex-wrap items-center justify-between gap-3">
  <div class="flex items-center gap-2 text-xs font-semibold text-stone-500">
    <a href="/pos/transactions" class="hover:text-ember">Transactions</a><span>/</span><span class="text-stone-700">{{transaction.transactionNumber}}</span>
  </div>
  <div class="flex flex-wrap gap-2">
    <a href="/pos/receipts/{{transaction.id}}" target="_blank" class="btn btn-primary">View / Reprint Receipt</a>
    <a href="/pos/orders/{{transaction.orderId}}" class="btn btn-light">Order</a>
  </div>
</div>

<section class="grid gap-6 xl:grid-cols-[minmax(0,1.5fr)_minmax(300px,1fr)]">
  <div class="space-y-6">
    <div class="card p-5">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-stone-400">Transaction number</p>
          <h2 class="mt-1 font-mono text-xl font-extrabold text-charcoal">{{transaction.transactionNumber}}</h2>
          <p class="mt-1 text-xs text-stone-500">Order {{transaction.orderNumber}} · {{datetime transaction.createdAt}}</p>
        </div>
        <div class="flex gap-2">
          <span class="badge {{statusBadge transaction.status}}">{{transaction.status}}</span>
          <span class="badge {{statusBadge transaction.paymentStatus}}">{{transaction.paymentStatus}}</span>
        </div>
      </div>

      <dl class="mt-5 grid grid-cols-2 gap-3 text-sm sm:grid-cols-4">
        <div class="rounded-xl bg-stone-50 p-3"><dt class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Cashier</dt><dd class="mt-1 font-semibold text-stone-800">{{transaction.cashierName}}</dd></div>
        <div class="rounded-xl bg-stone-50 p-3"><dt class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Order type</dt><dd class="mt-1 font-semibold text-stone-800">{{transaction.order.orderType}}</dd></div>
        <div class="rounded-xl bg-stone-50 p-3"><dt class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Table</dt><dd class="mt-1 font-semibold text-stone-800">{{#if transaction.order.table}}{{transaction.order.table.name}}{{else}}—{{/if}}</dd></div>
        <div class="rounded-xl bg-stone-50 p-3"><dt class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Total</dt><dd class="mt-1 font-semibold text-ember">{{money transaction.totalAmount}}</dd></div>
      </dl>

      {{#if transaction.voidReason}}
        <div class="mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-xs text-red-800">
          <strong>Voided:</strong> {{transaction.voidReason}} · {{datetime transaction.voidedAt}}
        </div>
      {{/if}}
    </div>

    <div class="card overflow-hidden">
      <div class="border-b border-stone-200/80 px-5 py-4"><h2 class="text-base font-bold text-charcoal">Sold Items</h2></div>
      <div class="table-wrap">
        <table class="data-table">
          <thead><tr><th>Product</th><th>Unit price</th><th>Qty</th><th class="text-right">Subtotal</th></tr></thead>
          <tbody>
            {{#each transaction.order.items}}
              <tr>
                <td class="font-semibold text-stone-800">{{this.productName}}</td>
                <td class="text-stone-600">{{money this.unitPrice}}</td>
                <td>{{int this.quantity}}</td>
                <td class="text-right font-bold">{{money this.subtotal}}</td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>

    <div class="card overflow-hidden">
      <div class="border-b border-stone-200/80 px-5 py-4">
        <h2 class="text-base font-bold text-charcoal">Inventory Movements</h2>
        <p class="text-xs text-stone-500">Sales deductions and reversals linked to this sale</p>
      </div>
      <div class="table-wrap">
        <table class="data-table">
          <thead><tr><th>Product</th><th>Type</th><th>Qty</th><th>Stock</th><th>When</th></tr></thead>
          <tbody>
            {{#each movements}}
              <tr>
                <td class="font-semibold text-stone-800">{{this.productName}}</td>
                <td><span class="badge bg-stone-100 text-stone-600">{{this.type}}</span></td>
                <td class="font-bold">{{int this.quantity}}</td>
                <td class="text-stone-500">{{int this.previousStock}} → {{int this.newStock}}</td>
                <td class="text-stone-500">{{datetime this.createdAt}}</td>
              </tr>
            {{else}}
              <tr><td colspan="5" class="py-8 text-center text-sm text-stone-500">No linked movements.</td></tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <aside class="space-y-6">
    <div class="card p-5">
      <h2 class="text-sm font-bold uppercase tracking-wider text-stone-500">Payment Breakdown</h2>
      <dl class="mt-3 space-y-1.5 text-sm">
        <div class="flex justify-between text-stone-500"><dt>Subtotal</dt><dd class="font-semibold">{{money transaction.subtotal}}</dd></div>
        <div class="flex justify-between text-stone-500"><dt>Discount</dt><dd class="font-semibold">−{{money transaction.discountAmount}}</dd></div>
        <div class="flex justify-between text-stone-500"><dt>Service charge</dt><dd class="font-semibold">{{money transaction.serviceCharge}}</dd></div>
        <div class="flex justify-between text-stone-500"><dt>Tax</dt><dd class="font-semibold">{{money transaction.taxAmount}}</dd></div>
        <div class="flex justify-between border-t border-dashed border-stone-200 pt-2"><dt class="font-bold">Total</dt><dd class="font-extrabold text-ember">{{money transaction.totalAmount}}</dd></div>
      </dl>

      {{#each transaction.payments}}
        <div class="mt-4 rounded-xl bg-stone-50 p-3 text-xs">
          <div class="flex justify-between"><span class="text-stone-500">Method</span><span class="font-bold text-stone-800">{{this.method}}</span></div>
          <div class="mt-1 flex justify-between"><span class="text-stone-500">Received</span><span class="font-semibold">{{money this.amountReceived}}</span></div>
          <div class="mt-1 flex justify-between"><span class="text-stone-500">Change</span><span class="font-semibold">{{money this.changeDue}}</span></div>
          {{#if this.referenceNumber}}<div class="mt-1 flex justify-between"><span class="text-stone-500">Reference</span><span class="font-mono">{{this.referenceNumber}}</span></div>{{/if}}
          <div class="mt-1 flex justify-between"><span class="text-stone-500">Status</span><span class="badge {{statusBadge this.status}}">{{this.status}}</span></div>
        </div>
      {{/each}}

      {{#each transaction.discounts}}
        <div class="mt-2 rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-xs">
          <p class="font-bold text-emerald-800">{{this.name}}</p>
          <p class="text-emerald-700">−{{money this.amount}} · authorized by {{this.authorizedByName}}</p>
        </div>
      {{/each}}
    </div>

    {{#if canVoid}}
      <div class="card border-red-200 p-5">
        <h2 class="text-sm font-bold uppercase tracking-wider text-red-600">Void / Refund</h2>
        <p class="mt-2 text-[11px] leading-relaxed text-stone-500">
          Voiding restores every sold item to inventory as a Void/Reversal movement and marks the payment Refunded. This cannot be undone.
        </p>
        <form method="POST" action="/pos/transactions/{{transaction.id}}/void" class="mt-3 space-y-2" data-confirm="Void {{transaction.transactionNumber}} and restore stock?">
          <textarea name="reason" rows="2" required minlength="5" maxlength="500" class="textarea" placeholder="Reason for void / refund *"></textarea>
          <button type="submit" class="btn btn-danger w-full">Void Transaction &amp; Restock</button>
        </form>
      </div>
    {{/if}}
  </aside>
</section>

{{> app-foot}}
