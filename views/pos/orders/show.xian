{{> app-head title="Order Details" active="orders" subtitle=order.orderNumber}}

<div class="flex flex-wrap items-center justify-between gap-3">
  <div class="flex items-center gap-2 text-xs font-semibold text-stone-500">
    <a href="/pos/orders" class="hover:text-ember">Orders</a><span>/</span><span class="text-stone-700">{{order.orderNumber}}</span>
  </div>
  <div class="flex flex-wrap gap-2">
    {{#if (eq order.status "Pending")}}
      <a href="/pos/checkout/{{order.id}}" class="btn btn-primary">Proceed to Checkout</a>
    {{/if}}
    {{#if order.transaction}}
      <a href="/pos/transactions/{{order.transaction.id}}" class="btn btn-light">View Transaction</a>
      <a href="/pos/receipts/{{order.transaction.id}}" target="_blank" class="btn btn-light">Receipt</a>
    {{/if}}
  </div>
</div>

<section class="grid gap-6 xl:grid-cols-[minmax(0,1.5fr)_minmax(300px,1fr)]">
  <div class="space-y-6">
    <div class="card p-5">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-stone-400">Order number</p>
          <h2 class="mt-1 text-2xl font-extrabold text-charcoal">{{order.orderNumber}}</h2>
          <p class="mt-1 text-xs text-stone-500">Placed {{datetime order.createdAt}} by {{order.cashierName}}</p>
        </div>
        <span class="badge {{statusBadge order.status}}">{{order.status}}</span>
      </div>

      <dl class="mt-5 grid grid-cols-2 gap-3 text-sm sm:grid-cols-4">
        <div class="rounded-xl bg-stone-50 p-3"><dt class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Order type</dt><dd class="mt-1 font-semibold text-stone-800">{{order.orderType}}</dd></div>
        <div class="rounded-xl bg-stone-50 p-3"><dt class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Table</dt><dd class="mt-1 font-semibold text-stone-800">{{#if order.table}}{{order.table.name}}{{else}}—{{/if}}</dd></div>
        <div class="rounded-xl bg-stone-50 p-3"><dt class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Items</dt><dd class="mt-1 font-semibold text-stone-800">{{order.items.length}}</dd></div>
        <div class="rounded-xl bg-stone-50 p-3"><dt class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Total</dt><dd class="mt-1 font-semibold text-ember">{{money order.totalAmount}}</dd></div>
      </dl>

      {{#if order.note}}
        <div class="mt-4 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-xs text-amber-800"><strong>Note:</strong> {{order.note}}</div>
      {{/if}}
    </div>

    <div class="card overflow-hidden">
      <div class="border-b border-stone-200/80 px-5 py-4"><h2 class="text-base font-bold text-charcoal">Order Items</h2></div>
      <div class="table-wrap">
        <table class="data-table">
          <thead><tr><th>Product</th><th>Unit price</th><th>Qty</th><th class="text-right">Subtotal</th></tr></thead>
          <tbody>
            {{#each order.items}}
              <tr>
                <td class="font-semibold text-stone-800">{{this.productName}}</td>
                <td class="text-stone-600">{{money this.unitPrice}}</td>
                <td>{{int this.quantity}}</td>
                <td class="text-right font-bold">{{money this.subtotal}}</td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      <div class="border-t border-stone-200/80 px-5 py-4">
        <dl class="ml-auto max-w-xs space-y-1.5 text-sm">
          <div class="flex justify-between text-stone-500"><dt>Subtotal</dt><dd class="font-semibold text-stone-700">{{money order.subtotal}}</dd></div>
          <div class="flex justify-between text-stone-500"><dt>Discount</dt><dd class="font-semibold text-stone-700">−{{money order.discountAmount}}</dd></div>
          <div class="flex justify-between text-stone-500"><dt>Service charge</dt><dd class="font-semibold text-stone-700">{{money order.serviceCharge}}</dd></div>
          <div class="flex justify-between text-stone-500"><dt>Tax</dt><dd class="font-semibold text-stone-700">{{money order.taxAmount}}</dd></div>
          <div class="flex justify-between border-t border-dashed border-stone-200 pt-2 text-base"><dt class="font-bold text-charcoal">Total</dt><dd class="font-extrabold text-ember">{{money order.totalAmount}}</dd></div>
        </dl>
      </div>
    </div>
  </div>

  <aside class="space-y-6">
    {{#if canUpdateStatus}}
      <div class="card p-5">
        <h2 class="text-sm font-bold uppercase tracking-wider text-stone-500">Update Status</h2>
        {{#if allowedTransitions.length}}
          <div class="mt-3 flex flex-wrap gap-2">
            {{#each allowedTransitions}}
              <form method="POST" action="/pos/orders/{{../order.id}}/status">
                <input type="hidden" name="status" value="{{this}}" />
                <button type="submit" class="btn btn-dark text-xs">Mark {{this}}</button>
              </form>
            {{/each}}
          </div>
          <p class="mt-3 text-[11px] text-stone-400">Status flow: Pending → Preparing → Ready → Completed.</p>
        {{else}}
          <p class="mt-2 text-sm text-stone-500">No further status changes are allowed for this order.</p>
        {{/if}}
      </div>
    {{/if}}

    {{#if order.transaction}}
      <div class="card p-5">
        <h2 class="text-sm font-bold uppercase tracking-wider text-stone-500">Payment</h2>
        <dl class="mt-3 space-y-2 text-sm">
          <div class="flex justify-between"><dt class="text-stone-500">Transaction</dt><dd class="font-semibold">{{order.transaction.transactionNumber}}</dd></div>
          <div class="flex justify-between"><dt class="text-stone-500">Payment status</dt><dd><span class="badge {{statusBadge order.transaction.paymentStatus}}">{{order.transaction.paymentStatus}}</span></dd></div>
          {{#each order.transaction.payments}}
            <div class="flex justify-between"><dt class="text-stone-500">Method</dt><dd class="font-semibold">{{this.method}}</dd></div>
            <div class="flex justify-between"><dt class="text-stone-500">Received</dt><dd class="font-semibold">{{money this.amountReceived}}</dd></div>
            <div class="flex justify-between"><dt class="text-stone-500">Change</dt><dd class="font-semibold">{{money this.changeDue}}</dd></div>
          {{/each}}
        </dl>
      </div>
    {{/if}}

    {{#if canCancel}}
      <div class="card p-5">
        <h2 class="text-sm font-bold uppercase tracking-wider text-stone-500">Cancel Order</h2>
        <p class="mt-2 text-[11px] leading-relaxed text-stone-500">Only unpaid pending orders can be cancelled. Paid sales must be voided from the transaction page by an administrator.</p>
        <form method="POST" action="/pos/orders/{{order.id}}/cancel" class="mt-3" data-confirm="Cancel order {{order.orderNumber}}? No stock has been deducted yet.">
          <button type="submit" class="btn btn-danger w-full">Cancel Order</button>
        </form>
      </div>
    {{/if}}
  </aside>
</section>

{{> app-foot}}
