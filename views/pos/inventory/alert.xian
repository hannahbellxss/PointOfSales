{{> app-head title=title active="inventory" subtitle="Stock alerts that need action"}}

<div class="flex flex-wrap items-center justify-between gap-3">
  <div class="flex gap-2">
    <a href="/pos/inventory/low-stock" class="btn {{#if (eq mode 'low')}}btn-dark{{else}}btn-light{{/if}}">⚠️ Low Stock</a>
    <a href="/pos/inventory/out-of-stock" class="btn {{#if (eq mode 'out')}}btn-dark{{else}}btn-light{{/if}}">⛔ Out of Stock</a>
  </div>
  {{#can "inventory.manage"}}
    <a href="/pos/inventory/stock-in" class="btn btn-primary">+ Record Stock In</a>
  {{/can}}
</div>

<section class="grid grid-cols-2 gap-3 lg:grid-cols-4">
  <div class="card p-4"><p class="text-[10px] font-bold uppercase tracking-wider text-zinc-500">Products listed</p><p class="stat-value mt-1 text-xl">{{int summary.totalProducts}}</p></div>
  <div class="card p-4"><p class="text-[10px] font-bold uppercase tracking-wider text-zinc-500">Units on hand</p><p class="stat-value mt-1 text-xl">{{int summary.totalUnits}}</p></div>
  <div class="card p-4"><p class="text-[10px] font-bold uppercase tracking-wider text-zinc-500">Low stock</p><p class="stat-value mt-1 text-xl text-amber-400">{{int summary.lowStock}}</p></div>
  <div class="card p-4"><p class="text-[10px] font-bold uppercase tracking-wider text-zinc-500">Out of stock</p><p class="stat-value mt-1 text-xl text-red-400">{{int summary.outOfStock}}</p></div>
</section>

<section class="card overflow-hidden">
  <div class="table-wrap">
    <table class="data-table">
      <thead><tr><th>Product</th><th>Category</th><th>On hand</th><th>Minimum</th><th>Status</th><th>Last updated</th><th class="text-right">Action</th></tr></thead>
      <tbody>
        {{#each rows}}
          <tr>
            <td>
              <div class="flex items-center gap-3">
                <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-white/[0.06] text-sm">🍽️</div>
                <a href="/pos/inventory/{{this.productId}}" class="font-bold text-white hover:text-ember">{{this.name}}</a>
              </div>
            </td>
            <td class="text-zinc-400">{{#if this.categoryName}}{{this.categoryName}}{{else}}—{{/if}}</td>
            <td class="font-bold {{#if (eq this.stockStatus 'Out of Stock')}}text-red-400{{else}}text-amber-300{{/if}}">{{int this.currentStock}} <span class="text-[11px] font-normal text-zinc-500">{{this.unit}}</span></td>
            <td class="text-zinc-400">{{int this.minStockLevel}}</td>
            <td><span class="badge {{badge this.stockStatus}}">{{this.stockStatus}}</span></td>
            <td class="whitespace-nowrap text-zinc-400">{{datetime this.lastUpdated}}</td>
            <td class="text-right">
              {{#can "inventory.manage"}}
                <a href="/pos/inventory/stock-in?product={{this.productId}}" class="btn btn-light px-2.5 py-1 text-[11px]">Stock In</a>
              {{else}}
                <a href="/pos/inventory/{{this.productId}}" class="btn btn-light px-2.5 py-1 text-[11px]">View</a>
              {{/can}}
            </td>
          </tr>
        {{else}}
          <tr>
            <td colspan="7" class="py-12 text-center">
              <p class="text-3xl">{{#if (eq mode "low")}}✅{{else}}🎉{{/if}}</p>
              <p class="mt-2 text-sm font-semibold text-zinc-200">
                {{#if (eq mode "low")}}No products are low on stock.{{else}}Nothing is out of stock right now.{{/if}}
              </p>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>

{{> app-foot}}
