{{> app-head title=title active="inventory" subtitle="Stock record and complete movement history"}}

<div class="flex flex-wrap items-center justify-between gap-3">
  <div class="flex items-center gap-2 text-xs font-semibold text-stone-500">
    <a href="/pos/inventory" class="hover:text-ember">Inventory</a><span>/</span><span class="text-stone-700">{{product.name}}</span>
  </div>
  {{#can "inventory.manage"}}
    <div class="flex flex-wrap gap-2">
      <a href="/pos/inventory/stock-in?product={{product.id}}" class="btn btn-primary">Stock In</a>
      <a href="/pos/inventory/stock-out?product={{product.id}}" class="btn btn-light">Stock Out</a>
      <a href="/pos/inventory/adjustment?product={{product.id}}" class="btn btn-light">Adjustment</a>
    </div>
  {{/can}}
</div>

<section class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_340px]">
  <div class="space-y-6">
    <div class="card p-5">
      <div class="flex flex-wrap items-start gap-4">
        <div class="h-20 w-20 shrink-0 overflow-hidden rounded-2xl bg-stone-100">
          {{#if product.image}}<img src="{{product.image}}" alt="{{product.name}}" class="h-full w-full object-cover" />{{else}}<div class="flex h-full w-full items-center justify-center text-2xl">🍽️</div>{{/if}}
        </div>
        <div class="min-w-0 flex-1">
          <h2 class="text-xl font-extrabold text-charcoal">{{product.name}}</h2>
          <p class="text-xs text-stone-500">{{product.category.name}} · {{product.type}} · {{money product.price}}</p>
          <p class="mt-2 max-w-xl text-sm text-stone-600">{{#if product.description}}{{product.description}}{{else}}No description.{{/if}}</p>
        </div>
        <span class="badge {{badge inventory.stockStatus}}">{{inventory.stockStatus}}</span>
      </div>

      <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4">
        <div class="rounded-xl bg-stone-50 p-3"><p class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Current stock</p><p class="mt-1 text-xl font-extrabold text-charcoal">{{int inventory.currentStock}} <span class="text-xs font-semibold text-stone-400">{{inventory.unit}}</span></p></div>
        <div class="rounded-xl bg-stone-50 p-3"><p class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Minimum level</p><p class="mt-1 text-xl font-extrabold text-charcoal">{{int inventory.minStockLevel}}</p></div>
        <div class="rounded-xl bg-stone-50 p-3"><p class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Stock value</p><p class="mt-1 text-xl font-extrabold text-charcoal">{{money stockValue}}</p></div>
        <div class="rounded-xl bg-stone-50 p-3"><p class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Last updated</p><p class="mt-1 text-xs font-semibold text-stone-700">{{datetime inventory.lastUpdated}}</p></div>
      </div>
    </div>

    <div class="card overflow-hidden">
      <div class="border-b border-stone-200/80 px-5 py-4">
        <h2 class="text-base font-bold text-charcoal">Movement History</h2>
        <p class="text-xs text-stone-500">Every change to this product's stock</p>
      </div>
      <div class="table-wrap">
        <table class="data-table">
          <thead><tr><th>Date</th><th>Type</th><th>Qty</th><th>Stock</th><th>Reference</th><th>By</th></tr></thead>
          <tbody>
            {{#each movements}}
              <tr>
                <td class="whitespace-nowrap text-stone-500">{{datetime this.createdAt}}</td>
                <td><span class="badge bg-stone-100 text-stone-600">{{this.type}}</span></td>
                <td class="font-bold">{{int this.quantity}}</td>
                <td class="text-stone-500">{{int this.previousStock}} → <span class="font-semibold text-stone-700">{{int this.newStock}}</span></td>
                <td class="font-mono text-[11px] text-stone-500">{{this.referenceNumber}}</td>
                <td class="text-stone-500">{{this.performedByName}}</td>
              </tr>
            {{else}}
              <tr><td colspan="6" class="py-10 text-center text-sm text-stone-500">No movements recorded for this product yet.</td></tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <aside class="space-y-6">
    {{#can "inventory.manage"}}
      <div class="card p-5">
        <h2 class="text-sm font-bold uppercase tracking-wider text-stone-500">Minimum Stock Level</h2>
        <form method="POST" action="/pos/inventory/{{product.id}}/min-level" class="mt-3 space-y-3">
          <input type="number" name="minStockLevel" min="0" step="1" value="{{inventory.minStockLevel}}" class="input" required />
          <p class="text-[11px] text-stone-400">The product is flagged Low Stock when on hand reaches this number.</p>
          <button type="submit" class="btn btn-dark w-full">Update minimum</button>
        </form>
      </div>
    {{/can}}

    <div class="card p-5">
      <h2 class="text-sm font-bold uppercase tracking-wider text-stone-500">Rules</h2>
      <ul class="mt-3 space-y-2 text-xs leading-relaxed text-stone-500">
        <li>• Stock only changes through recorded movements.</li>
        <li>• Sales deductions are created automatically at payment.</li>
        <li>• Voids and refunds restock through a reversal movement.</li>
        <li>• Negative stock is never allowed.</li>
      </ul>
    </div>
  </aside>
</section>

{{> app-foot}}
