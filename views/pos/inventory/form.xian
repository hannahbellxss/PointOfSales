{{> app-head title=title active="inventory" subtitle="Validated stock movement — every change is recorded"}}

<div class="flex items-center gap-2 text-xs font-semibold text-stone-500">
  <a href="/pos/inventory" class="hover:text-ember">Inventory</a><span>/</span><span class="text-stone-700">{{title}}</span>
</div>

<section class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_340px]">
  <form method="POST" action="{{#if (eq mode 'in')}}/pos/inventory/stock-in{{else}}{{#if (eq mode 'out')}}/pos/inventory/stock-out{{else}}/pos/inventory/adjustment{{/if}}{{/if}}" class="card p-5" data-submit-once>
    <h2 class="text-sm font-bold uppercase tracking-wider text-stone-500">
      {{#if (eq mode "in")}}Stock In Details{{else}}{{#if (eq mode "out")}}Stock Out Details{{else}}Stock Adjustment Details{{/if}}{{/if}}
    </h2>

    <div class="mt-4 space-y-4">
      <div>
        <label class="label" for="productId">Product *</label>
        <select id="productId" name="productId" required class="select">
          <option value="">Select a product…</option>
          {{#each products}}
            <option value="{{this.id}}" data-stock="{{this.inventory.currentStock}}" data-unit="{{this.inventory.unit}}" data-min="{{this.inventory.minStockLevel}}" {{selected this.id ../selected}}>
              {{this.name}} — {{this.inventory.currentStock}} {{this.inventory.unit}} on hand
            </option>
          {{/each}}
        </select>
      </div>

      <div id="stock-preview" class="hidden rounded-xl border border-stone-200 bg-stone-50 p-4">
        <p class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Current stock</p>
        <p class="mt-1 text-lg font-extrabold text-charcoal"><span id="preview-stock">0</span> <span id="preview-unit" class="text-xs font-semibold text-stone-500">pcs</span></p>
        <p class="text-[11px] text-stone-500">Minimum level: <span id="preview-min">0</span></p>
      </div>

      {{#if (eq mode "adjust")}}
        <div>
          <label class="label" for="newStock">Counted stock (new quantity) *</label>
          <input id="newStock" name="newStock" type="number" min="0" step="1" required class="input" placeholder="0" />
          <p class="mt-1 text-[11px] text-stone-400">Enter the physical count. The difference is recorded as an Adjustment.</p>
        </div>
      {{else}}
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label class="label" for="quantity">Quantity *</label>
            <input id="quantity" name="quantity" type="number" min="1" step="1" required class="input" placeholder="0" />
          </div>
          <div>
            <label class="label" for="referenceNumber">Reference number</label>
            <input id="referenceNumber" name="referenceNumber" maxlength="64" class="input" placeholder="Delivery slip / supplier invoice" />
          </div>
        </div>
      {{/if}}

      <div>
        <label class="label" for="reason">Reason {{#if (eq mode "in")}}(optional){{else}}*{{/if}}</label>
        <textarea id="reason" name="reason" rows="3" maxlength="500" class="textarea"
          placeholder="{{#if (eq mode 'in')}}Received delivery, return to stock…{{else}}{{#if (eq mode 'out')}}Spoilage, staff meal, transfer, waste…{{else}}Physical count correction, damaged goods…{{/if}}{{/if}}"
          {{#unless (eq mode "in")}}required{{/unless}}></textarea>
      </div>

      <div class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-xs leading-relaxed text-amber-800">
        {{#if (eq mode "in")}}
          Stock In increases the quantity on hand and records the movement with your name and the timestamp.
        {{else}}
          {{#if (eq mode "out")}}
            Stock Out decreases the quantity on hand. You cannot remove more than the current stock, and a reason is required.
          {{else}}
            Adjustments set the counted quantity. A reason of at least 5 characters is required for the audit trail.
          {{/if}}
        {{/if}}
      </div>

      <div class="flex gap-2">
        <button type="submit" class="btn btn-primary">Record {{#if (eq mode "in")}}Stock In{{else}}{{#if (eq mode "out")}}Stock Out{{else}}Adjustment{{/if}}{{/if}}</button>
        <a href="/pos/inventory" class="btn btn-light">Cancel</a>
      </div>
    </div>
  </form>

  <aside class="space-y-6">
    <div class="card p-5">
      <h2 class="text-sm font-bold uppercase tracking-wider text-stone-500">Quick Links</h2>
      <div class="mt-3 space-y-2 text-sm">
        <a href="/pos/inventory/low-stock" class="flex items-center justify-between rounded-lg px-2 py-1.5 text-stone-600 hover:bg-stone-50">Low stock products <span>→</span></a>
        <a href="/pos/inventory/out-of-stock" class="flex items-center justify-between rounded-lg px-2 py-1.5 text-stone-600 hover:bg-stone-50">Out of stock products <span>→</span></a>
        <a href="/pos/inventory/movements" class="flex items-center justify-between rounded-lg px-2 py-1.5 text-stone-600 hover:bg-stone-50">Movement history <span>→</span></a>
      </div>
    </div>
    <div class="card p-5 text-xs leading-relaxed text-stone-500">
      <h2 class="text-sm font-bold uppercase tracking-wider text-stone-500">Why this matters</h2>
      <p class="mt-2">Inventory cannot be edited directly. Recording a movement keeps stock and sales consistent and gives every change an audit trail.</p>
    </div>
  </aside>
</section>

<script>
  const select = document.getElementById("productId");
  const preview = document.getElementById("stock-preview");

  function updatePreview() {
    const option = select.options[select.selectedIndex];
    if (!option || !option.value) {
      preview.classList.add("hidden");
      return;
    }
    preview.classList.remove("hidden");
    document.getElementById("preview-stock").textContent = option.dataset.stock ?? "0";
    document.getElementById("preview-unit").textContent = option.dataset.unit || "pcs";
    document.getElementById("preview-min").textContent = option.dataset.min ?? "0";
  }

  select.addEventListener("change", updatePreview);
  updatePreview();
</script>

{{> app-foot}}
