<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{title}} · DJYum</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: { extend: { colors: { ember: "#FFC400" } } }
    };
  </script>
</head>
<body class="flex min-h-screen items-center justify-center bg-[#0A0A0B] px-4 text-zinc-200">
  <div class="w-full max-w-md rounded-2xl border border-white/10 bg-[#141417] p-8 text-center shadow-2xl shadow-black/50">
    <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-ember/15 text-2xl text-ember">🍽️</div>
    <p class="mt-5 text-xs font-bold uppercase tracking-[0.2em] text-ember">Error {{status}}</p>
    <h1 class="mt-2 text-2xl font-extrabold text-white">{{title}}</h1>
    <p class="mt-2 text-sm text-zinc-400">{{message}}</p>
    <div class="mt-6 flex justify-center gap-2">
      <a href="/dashboard" class="rounded-lg bg-ember px-4 py-2 text-sm font-bold text-black hover:bg-[#FFD54A]">Go to Dashboard</a>
      <a href="/pos/terminal" class="rounded-lg border border-white/10 px-4 py-2 text-sm font-semibold text-zinc-300 hover:bg-white/5">POS Terminal</a>
    </div>
  </div>
</body>
</html>
